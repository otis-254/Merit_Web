# Neon Database Connection String
# Get this from your Neon dashboard: https://console.neon.tech/
NEON_DATABASE_URL=postgresql://username:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# Email Configuration (if using EmailJS for notifications)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id_for_admin
EMAILJS_USER_TEMPLATE_ID=your_template_id_for_user_confirmation
EMAILJS_PUBLIC_KEY=your_public_key
